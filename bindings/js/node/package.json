{
  "name": "@libmorpheus/node",
  "version": "0.1.3",
  "description": "Node.js binding for the libmorpheus morphological analyzer",
  "type": "module",
  "types": "./index.d.ts",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/defense-humanites/libmorpheus.git",
    "directory": "bindings/js/node"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./native": {
      "types": "./native.d.ts",
      "import": "./native.js"
    },
    "./data": {
      "types": "./data.d.ts",
      "import": "./data.js"
    },
    "./setup": {
      "types": "./setup.d.ts",
      "import": "./setup.js"
    }
  },
  "bin": {
    "libmorpheus-native": "./native.js",
    "libmorpheus-data": "./data.js",
    "libmorpheus-setup": "./setup.js"
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "README.md",
    "data.d.ts",
    "data.js",
    "internal",
    "index.d.ts",
    "index.js",
    "native.d.ts",
    "native.js",
    "setup.d.ts",
    "setup.js"
  ],
  "dependencies": {
    "@libmorpheus/data": "0.1.0"
  },
  "optionalDependencies": {
    "@libmorpheus/node-darwin-arm64": "0.1.3",
    "@libmorpheus/node-linux-arm64-gnu": "0.1.3",
    "@libmorpheus/node-linux-x64-gnu": "0.1.3"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  }
}
